# =============================================
# BotMinecraft2 — Environment Variables Example
# =============================================
# Copy to .env and fill in your values

# --- Bot Accounts (comma-separated, matches config.js bots array order) ---
BOT_USERNAMES=Bot-Nenel10,Bot-Nenel20
BOT_PASSWORDS=,

# --- Groq AI API Key (for primary bot chat intelligence) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Server ---
SERVER_HOST=rhsmp.mc.hrkm.my.id
SERVER_PORT=25565

# --- Log Level (debug | info | warn | error) ---
LOG_LEVEL=info
