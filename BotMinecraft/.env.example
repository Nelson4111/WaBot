# ==================================================
# MINECRAFT BOT — SENSITIVE CONFIGURATION
# ==================================================
# JANGAN upload file ini ke Git!
# Salin file ini menjadi .env dan isi dengan nilai yang benar

# ── Bot Credentials ────────────────────────────────
BOT_USERNAME=BotNenel1
BOT_PASSWORD=513

# ── Server Target ──────────────────────────────────
SERVER_HOST=rhsmp.mc.hrkm.my.id
# Default port Minecraft Java Edition adalah 25565
SERVER_PORT=25565

# ── Web Dashboard ──────────────────────────────────
# Set 'false' jika jalan di game panel/VPS tanpa port web
WEB_ENABLED=false
WEB_PORT=3000

# ── Environment ────────────────────────────────────
# Gunakan 'production' di VPS, 'development' untuk debug lokal
NODE_ENV=production

# ── Gemini AI Integration ──────────────────────────
# Dapatkan API key dari Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
