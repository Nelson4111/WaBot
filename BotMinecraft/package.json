{
  "name": "minecraft-afk-bot",
  "version": "1.0.0",
  "description": "Production-ready Minecraft AFK Bot built with Mineflayer",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0",
    "note": "Mineflayer recommends Node >=22 but works on Node 20 LTS"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop minecraft-bot",
    "pm2:restart": "pm2 restart minecraft-bot",
    "pm2:logs": "pm2 logs minecraft-bot",
    "pm2:status": "pm2 status",
    "lint": "eslint src/ index.js --ext .js",
    "lint:fix": "eslint src/ index.js --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"index.js\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"index.js\" \"*.js\""
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "bot",
    "afk",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fs-extra": "^11.2.0",
    "joi": "^17.13.3",
    "mineflayer": "^4.23.0",
    "mineflayer-auto-eat": "4.0.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "node-cron": "^3.0.3",
    "socks": "^2.8.9",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.4.2"
  }
}
