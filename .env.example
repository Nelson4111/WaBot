# ==========================================
# NelBot-MD Environment Configuration
# ==========================================

# Port Configuration
PORT=3000

# WhatsApp Pairing Code (Optional)
PAIRING_CODE=

# Groq API Keys (Support multi-key backup & automatic failover)
# Masukkan 1 atau lebih API key Groq kamu di bawah:
GROQ_API_KEY=gsk_your_primary_key_here
GROQ_KEY_1=gsk_your_backup_key_1_here
GROQ_KEY_2=gsk_your_backup_key_2_here
GROQ_KEY_3=gsk_your_backup_key_3_here

# Discord Bot (Jika menggunakan modul Discord)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PREFIX=.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
